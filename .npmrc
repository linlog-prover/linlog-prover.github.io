# npm only resolves package-lock.json here; nix installs it
# (modules/node-modules.nix), so `npm install <pkg>` writes package.json and
# the lock and never node_modules.
package-lock-only=true
save-exact=true
# Supply-chain hygiene (https://docs.npmjs.com/cli/v11/using-npm/config,
# checked 2026-10-10 against npm 11.19): a version must have been public for
# two weeks before it can enter the lock -- long enough for a compromised
# release to be noticed and yanked; no package's install scripts run, and no
# dependency may come from a git URL, where no registry integrity hash
# applies.
min-release-age=14
ignore-scripts=true
allow-git=none
engine-strict=true
fund=false
