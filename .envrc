# shellcheck shell=bash
# linlog © Fabian Lukas Grubmüller 2026
# Licensed under the EUPL

# nix-direnv only watches flake.nix and flake.lock. The dev shell is assembled
# from modules/, and node-modules.nix reads package.json and package-lock.json
# at evaluation time, so an edit to any of them has to trigger a reload --
# that reload is what installs a new npm dependency.
watch_dir modules
watch_file package.json package-lock.json
use flake
