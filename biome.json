{
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/result*",
      "!!**/.direnv",
      "!!**/.astro",
      "!!**/.cache",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!**/package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts", "**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["solid-js", "solid-js/**"],
                    "message": "Solid code goes in .tsx files, where .claude/rules/island.md loads."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noSolidDestructuredProps": "error"
          },
          "performance": {
            "useSolidForComponent": "error"
          },
          "suspicious": {
            "noDuplicatedSpreadProps": "error",
            "noReactSpecificProps": "error"
          }
        }
      }
    }
  ]
}
