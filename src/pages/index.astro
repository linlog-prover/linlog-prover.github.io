// The one page: the prover, one Solid island rendered in the browser alone,
// since everything on it is the prover's and runs on linlog's module there.
// Without a script the page says what it is. linlog's math fonts, Euler
// Math, which the island loads for its drawings and exports, and the four
// others an export may be set in, are imported here, so that they are built
// as the other fonts are, under /fonts/ (astro.config.ts).
//
// The written content (src/content.config.ts) is rendered here into inert
// templates, each marked data-written, which the island clones where it
// shows them (Learn, Practice, the tour, About); Learn's problems (those of
// the store with a lesson, with their sessions), its lessons (their openings
// rendered here, the rest data), the rules and the tour's data go to the
// island as props. Practice's problems come from /problems.json. The licence of the written content is a template
// of its own, shown with it.
import asana from "linlog-fonts/Asana-Math.otf?url";
import euler from "linlog-fonts/Euler-Math.otf?url";
import garamond from "linlog-fonts/Garamond-Math.otf?url";
import newcm from "linlog-fonts/NewCMMath-Book.otf?url";
import stix from "linlog-fonts/STIXTwoMath-Regular.otf?url";
import { getCollection, render } from "astro:content";
import App from "../islands/App";
import type { Example, Lesson, Rule, Stop } from "../lib/content";
import Base from "../layouts/Base.astro";

const sessions = import.meta.glob<string>("../content/problems/*.session.json", {
  query: "?raw",
  import: "default",
  eager: true,
});
const examples = (await getCollection("problems"))
  .filter((p) => p.data.lesson !== undefined)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const stops = (await getCollection("tour")).sort((a, b) => a.id.localeCompare(b.id));
const texts = await getCollection("texts");
const lessons = (await getCollection("lessons")).sort((a, b) => a.data.lesson - b.data.lesson);
const rules = (await getCollection("rules")).sort((a, b) => a.id.localeCompare(b.id));

const exampleData: Example[] = examples.map((e) => ({
  id: e.id,
  title: e.data.title ?? e.data.sequent,
  sequent: e.data.sequent,
  mode: e.data.mode,
  level: e.data.level,
  lesson: e.data.lesson ?? 0,
  verdict: e.data.verdict,
  session: sessions[`../content/problems/${e.id}.session.json`] ?? null,
}));
const stopData: Stop[] = stops.map((s) => ({
  id: s.id,
  title: s.data.title,
  target: s.data.target,
  act: s.data.act,
}));
const lessonData: Lesson[] = lessons.map((l) => ({
  id: l.id,
  ...l.data,
  detour: l.data.detour ?? null,
}));
const ruleData: Rule[] = rules.map((r) => ({ id: r.id, ...r.data }));
const rendered = await Promise.all(
  [...examples, ...stops, ...texts, ...lessons].map(async (entry) => ({
    key: `${entry.collection}/${entry.id}`,
    Content: (await render(entry)).Content,
  })),
);
---

<Base title="linlog" description="Prove sequents of linear logic step by step, in the browser.">
  <main>
    <h1 class="sr-only">linlog: linear logic, proved in the browser</h1>
    <App
      client:only="solid-js"
      fonts={{ euler, "stix-two": stix, garamond, asana, "new-computer-modern": newcm }}
      examples={exampleData}
      stops={stopData}
      lessons={lessonData}
      rules={ruleData}
    >
      <p slot="fallback" class="noscript">
        linlog proves sequents of linear logic in the browser; the page needs JavaScript and
        WebAssembly.
      </p>
    </App>
    {
      rendered.map(({ key, Content }) => (
        <template data-written data-content={key}>
          <Content />
        </template>
      ))
    }
    <template data-written data-content="licence">
      <p class="licence">
        The text of this page is © Fabian Lukas Grubmüller 2026, licensed under
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>.
      </p>
    </template>
  </main>
</Base>
